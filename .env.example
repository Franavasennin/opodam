# Variables de entorno de OpoDAM. Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore: NUNCA se sube al repo.

# --- Cliente (build, expuestas en el navegador; deben llevar prefijo VITE_) ---
# Proyecto Supabase (sincronización y acceso por magic link). La anon key es pública por diseño.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Netlify Functions (servidor; SECRETAS, configúralas en Netlify > Environment variables) ---
# Clave de Groq para tutor, entrevista, DELTA y generación de preguntas. ROTAR si se filtró.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Orígenes permitidos para CORS de las functions (coma-separados). Ej.: https://opodam.netlify.app
ALLOWED_ORIGINS=http://localhost:3000
VITE_URL_EXPIRACION=https://opodam.vercel.app/precios

# --- Sentry — monitorización de errores ---
# DSN público (no es secreto). Obtener en sentry.io > Settings > Client Keys
VITE_SENTRY_DSN=https://xxxxxxxx@oXXXXX.ingest.sentry.io/YYYYYYY

# --- SendGrid — emails transaccionales + marketing ---
# API key de SendGrid (Settings > API Keys > Create). Permisos: Mail Send.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Dirección remitente verificada en SendGrid (Sender Authentication)
SENDGRID_FROM=noreply@opodam.es
