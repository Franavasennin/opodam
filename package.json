{
  "name": "opodam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/gen-search-index.mjs",
    "dev": "vite",
    "dev:fast": "vite",
    "gen:search": "node scripts/gen-search-index.mjs",
    "prebuild": "node scripts/gen-search-index.mjs && node scripts/gen-public-pages.mjs && node scripts/gen-sitemap.mjs",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "gen:public-pages": "node scripts/gen-public-pages.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.8",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/react": "^10.57.0",
    "@supabase/supabase-js": "^2.105.1",
    "@xyflow/react": "^12.10.2",
    "date-fns": "^4.1.0",
    "mermaid": "^11.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "stripe": "^22.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@xenova/transformers": "^2.17.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.10",
    "supabase": "^2.105.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4"
